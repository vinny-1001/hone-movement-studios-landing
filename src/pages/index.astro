---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import SocialProof from "../components/SocialProof.astro";
import Studios from "../components/Studios.astro";
import Pricing from "../components/Pricing.astro";
import Testimonials from "../components/Testimonials.astro";
import About from "../components/About.astro";
import InquiryForm from "../components/InquiryForm.astro";
import Footer from "../components/Footer.astro";
import StickyCTA from "../components/StickyCTA.astro";
---
<Layout
  title="Hone Movement Studios — A space for the work you love. Limehouse, E14"
  description="Two light-filled studio hire spaces in Limehouse, East London. Sprung floors, big mirrors, natural light. From £13/hr. Open 6am to 11pm, 7 days a week."
>
  <main id="main">
    <Hero />
    <SocialProof />
    <Studios />
    <Pricing />
    <Testimonials />
    <About />
    <InquiryForm />
  </main>
  <Footer />
  <StickyCTA />
</Layout>
