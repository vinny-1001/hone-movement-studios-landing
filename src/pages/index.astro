---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import SocialProof from "../components/SocialProof.astro";
import Studios from "../components/Studios.astro";
import Pricing from "../components/Pricing.astro";
import Testimonials from "../components/Testimonials.astro";
import About from "../components/About.astro";
import InquiryForm from "../components/InquiryForm.astro";
import Footer from "../components/Footer.astro";
import StickyCTA from "../components/StickyCTA.astro";
---
<Layout
  title="Hone Movement Studios — Studio hire in Limehouse, East London"
  description="Two self-serve dance and movement studios in a converted Victorian warehouse on Pixley Street, Limehouse. Sprung floors, full-height mirrors, natural light. From £13/hr. 6am–midnight."
>
  <main id="main">
    <Hero />
    <SocialProof />
    <Studios />
    <Pricing />
    <Testimonials />
    <About />
    <InquiryForm />
  </main>
  <Footer />
  <StickyCTA />
</Layout>
