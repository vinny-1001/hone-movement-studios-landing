---
import Wave from "./Wave.astro";
---

<footer class="brand-footer">
  <div class="brand-footer-inner">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-6 items-start">
      <div>
        <img
          src="/logos/hone-blue.png"
          alt="Hone Movement Studios"
          width="600"
          height="300"
          class="h-14 w-auto mb-3"
        />
        <p class="text-sm italic text-[var(--deep-slate)]/80 mb-2">A space for the work you love.</p>
        <p class="text-sm text-[var(--deep-slate)]/70">
          Pixley Street, Limehouse,<br />London E14
        </p>
      </div>
      <div>
        <p class="eyebrow mb-2">Hours</p>
        <p class="text-base">6am – 11pm, 7 days a week</p>
      </div>
      <div>
        <p class="eyebrow mb-2">Find us</p>
        <a
          href="https://instagram.com/honemovementstudios"
          class="inline-flex items-center gap-2 text-[var(--brand-blue)] underline underline-offset-4 hover:no-underline"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.2 2.2.4.5.2.9.5 1.3.9.4.4.7.8.9 1.3.2.4.4 1 .4 2.2.1 1.2.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.8-.4 2.2-.2.5-.5.9-.9 1.3-.4.4-.8.7-1.3.9-.4.2-1 .4-2.2.4-1.2.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.2-2.2-.4-.5-.2-.9-.5-1.3-.9-.4-.4-.7-.8-.9-1.3-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.2-1.8.4-2.2.2-.5.5-.9.9-1.3.4-.4.8-.7 1.3-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.1 0-3.5 0-4.7.1-1.1.1-1.7.2-2.1.4-.5.2-.9.5-1.3.8-.3.3-.6.7-.8 1.3-.2.4-.3 1-.4 2.1-.1 1.2-.1 1.6-.1 4.7s0 3.5.1 4.7c.1 1.1.2 1.7.4 2.1.2.5.5.9.8 1.3.4.4.7.6 1.3.8.4.2 1 .3 2.1.4 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1.1-.1 1.7-.2 2.1-.4.5-.2.9-.5 1.3-.8.4-.4.6-.7.8-1.3.2-.4.3-1 .4-2.1.1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c-.1-1.1-.2-1.7-.4-2.1-.2-.5-.5-.9-.8-1.3-.4-.4-.7-.6-1.3-.8-.4-.2-1-.3-2.1-.4-1.2-.1-1.6-.1-4.7-.1zm0 3.1c2.7 0 4.9 2.2 4.9 4.9s-2.2 4.9-4.9 4.9-4.9-2.2-4.9-4.9 2.2-4.9 4.9-4.9zm0 8c1.7 0 3.1-1.4 3.1-3.1S13.7 8.9 12 8.9 8.9 10.3 8.9 12s1.4 3.1 3.1 3.1zm6.3-8.2c0 .6-.5 1.1-1.1 1.1s-1.1-.5-1.1-1.1.5-1.1 1.1-1.1 1.1.5 1.1 1.1z" />
          </svg>
          @honemovementstudios
        </a>
      </div>
    </div>
    <div class="flex justify-center my-6">
      <Wave width={180} variant="primary" />
    </div>
    <p class="text-xs text-[var(--deep-slate)]/60 text-center">
      © 2026 Hone Movement Studios · 16 Pixley Street, London E14 7DF
    </p>
  </div>
</footer>

<style>
  .brand-footer {
    background: var(--cream);
    border-top: 1px solid rgba(60, 58, 75, 0.35);
    padding: 3rem 0 2rem;
  }
  .brand-footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }
  @media (min-width: 768px) {
    .brand-footer-inner {
      padding: 0 1.5rem;
    }
  }
  @media (min-width: 1024px) {
    .brand-footer-inner {
      padding: 0 3rem;
    }
  }
</style>
