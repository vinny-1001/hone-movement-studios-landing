---
---
<section class="relative bg-[var(--brand-blue)] text-white overflow-hidden">
  <div class="absolute inset-0 opacity-20 pointer-events-none" aria-hidden="true">
    <div class="absolute inset-0 bg-gradient-to-br from-white/10 via-transparent to-black/40"></div>
  </div>
  <div class="relative max-w-[1200px] mx-auto px-4 md:px-6 lg:px-12 py-16 md:py-24 lg:py-32 text-center">
    <p class="uppercase tracking-widest text-sm md:text-base text-white/70 mb-6">Hone Movement Studios · Limehouse, E14</p>
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold leading-tight mb-6">
      A serious space for serious practitioners.
    </h1>
    <p class="text-lg md:text-xl text-white/85 max-w-2xl mx-auto mb-10">
      Two studios in Limehouse, East London. From £13/hr. 6am–midnight.
    </p>
    <a
      href="#inquiry"
      class="press inline-block bg-white text-[var(--brand-blue)] font-bold text-lg px-8 py-4 rounded-md hover:bg-white/95 transition-colors min-h-[44px]"
    >
      Check Availability →
    </a>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-white/80">
      <span class="inline-flex items-center gap-1" aria-label="5 star rated">
        <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1l2.6 5.9 6.4.6-4.9 4.4 1.5 6.3L10 15l-5.6 3.2 1.5-6.3L1 7.5l6.4-.6L10 1z"/></svg>
        <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1l2.6 5.9 6.4.6-4.9 4.4 1.5 6.3L10 15l-5.6 3.2 1.5-6.3L1 7.5l6.4-.6L10 1z"/></svg>
        <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1l2.6 5.9 6.4.6-4.9 4.4 1.5 6.3L10 15l-5.6 3.2 1.5-6.3L1 7.5l6.4-.6L10 1z"/></svg>
        <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1l2.6 5.9 6.4.6-4.9 4.4 1.5 6.3L10 15l-5.6 3.2 1.5-6.3L1 7.5l6.4-.6L10 1z"/></svg>
        <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1l2.6 5.9 6.4.6-4.9 4.4 1.5 6.3L10 15l-5.6 3.2 1.5-6.3L1 7.5l6.4-.6L10 1z"/></svg>
      </span>
      <span aria-hidden="true">·</span>
      <span>Limehouse, E14</span>
      <span aria-hidden="true">·</span>
      <span>6am–midnight daily</span>
    </div>
  </div>
</section>
