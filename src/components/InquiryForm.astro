---
---
<section id="inquiry" class="bg-[var(--brand-blue)] text-white py-16 md:py-24 scroll-mt-4">
  <div class="max-w-[640px] mx-auto px-4 md:px-6">
    <div class="text-center mb-10">
      <h2 class="text-3xl md:text-5xl font-bold mb-3">Check availability</h2>
      <p class="text-lg text-white/85">
        Tell us what you need — we'll get back to you within a few hours.
      </p>
    </div>

    <form id="inquiry-form" novalidate>
      <div class="space-y-5">
        <div>
          <label for="firstName" class="block text-sm font-semibold mb-2">First name <span aria-hidden="true">*</span></label>
          <input
            id="firstName"
            name="firstName"
            type="text"
            required
            autocomplete="given-name"
            class="w-full bg-white text-[var(--dark-charcoal)] px-4 py-3 rounded-md min-h-[48px] border-2 border-transparent focus:border-white outline-none"
          />
        </div>

        <div>
          <label for="contact" class="block text-sm font-semibold mb-2">Email or WhatsApp <span aria-hidden="true">*</span></label>
          <input
            id="contact"
            name="contact"
            type="text"
            required
            autocomplete="email"
            placeholder="you@example.com or +44…"
            class="w-full bg-white text-[var(--dark-charcoal)] px-4 py-3 rounded-md min-h-[48px] border-2 border-transparent focus:border-white outline-none placeholder:text-[var(--dark-charcoal)]/50"
          />
        </div>

        <div>
          <label for="studio" class="block text-sm font-semibold mb-2">Which studio? <span aria-hidden="true">*</span></label>
          <select
            id="studio"
            name="studio"
            required
            class="w-full bg-white text-[var(--dark-charcoal)] px-4 py-3 rounded-md min-h-[48px] border-2 border-transparent focus:border-white outline-none"
          >
            <option value="Studio 28">Studio 28</option>
            <option value="Studio 49">Studio 49</option>
            <option value="Not sure yet">Not sure yet</option>
          </select>
        </div>

        <div>
          <label for="when" class="block text-sm font-semibold mb-2">When do you need it? <span aria-hidden="true">*</span></label>
          <input
            id="when"
            name="when"
            type="text"
            required
            placeholder="e.g. Tuesday evenings, this Saturday"
            class="w-full bg-white text-[var(--dark-charcoal)] px-4 py-3 rounded-md min-h-[48px] border-2 border-transparent focus:border-white outline-none placeholder:text-[var(--dark-charcoal)]/50"
          />
        </div>

        <button
          id="submit-btn"
          type="submit"
          class="press w-full bg-white text-[var(--brand-blue)] font-bold text-lg px-6 py-4 rounded-md min-h-[52px] hover:bg-white/95 transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
        >
          Send Inquiry →
        </button>

        <p id="form-error" hidden role="alert" class="text-white bg-red-700/70 border border-red-300 rounded-md px-4 py-3 text-sm">
          Something went wrong. Please try again, or message us on WhatsApp.
        </p>

        <p class="text-center text-sm text-white/80">
          We'll get back to you within a few hours.
        </p>
        <p class="text-center">
          <a
            href="https://wa.me/447000000000"
            class="inline-flex items-center gap-2 text-white underline underline-offset-4 hover:no-underline"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.1-.2.3-.8.9-1 1.1-.2.2-.4.2-.7.1-.3-.1-1.2-.4-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.3-.4.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.2.2-1.4-.1-.2-.3-.3-.6-.4zM12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.4 1.3 4.9L2 22l5.3-1.4c1.4.8 3 1.2 4.7 1.2 5.5 0 10-4.5 10-10S17.5 2 12 2z"/>
            </svg>
            Or message us on WhatsApp
          </a>
        </p>
      </div>
    </form>

    <div id="form-success" hidden class="text-center py-12" role="status" aria-live="polite">
      <svg class="w-16 h-16 mx-auto mb-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 12l3 3 5-6"/>
      </svg>
      <p class="text-2xl font-bold">Thanks — we'll be in touch shortly.</p>
    </div>
  </div>
</section>
