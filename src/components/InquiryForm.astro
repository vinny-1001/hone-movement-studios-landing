---
const today = new Date().toISOString().slice(0, 10);
---
<section id="inquiry" class="bg-[var(--cream)] py-16 md:py-24 scroll-mt-4 border-t border-[var(--deep-slate)]/15">
  <div class="max-w-[640px] mx-auto px-4 md:px-6">
    <div class="text-center mb-10">
      <p class="eyebrow mb-3">Prefer to ask first?</p>
      <h2 class="text-3xl md:text-5xl font-medium text-[var(--brand-blue)] mb-3">Drop us a message</h2>
      <p class="text-lg text-[var(--dark-charcoal)]/85">
        Tell us what you&rsquo;re thinking — we&rsquo;ll get back to you within a few hours.
      </p>
      <p class="mt-4 text-sm text-[var(--dark-charcoal)]/75">
        Or
        <a
          href="https://calendar.honemovementstudios.com/book"
          target="_blank"
          rel="noopener"
          class="text-[var(--brand-blue)] underline underline-offset-4 hover:no-underline font-medium"
        >book directly on the calendar →</a>
      </p>
    </div>

    <form id="inquiry-form" novalidate class="bg-[var(--paper)] border border-[var(--deep-slate)]/15 rounded-xl p-6 md:p-8">
      <div class="space-y-5">
        <div>
          <label for="firstName" class="block text-sm font-medium mb-2 text-[var(--dark-charcoal)]">First name <span aria-hidden="true">*</span></label>
          <input
            id="firstName"
            name="firstName"
            type="text"
            required
            autocomplete="given-name"
            class="w-full bg-[var(--cream)] text-[var(--dark-charcoal)] px-4 py-3 rounded-md min-h-[48px] border border-[var(--deep-slate)]/20 focus:border-[var(--brand-blue)] outline-none"
          />
        </div>

        <div>
          <label for="contact" class="block text-sm font-medium mb-2 text-[var(--dark-charcoal)]">Email <span aria-hidden="true">*</span></label>
          <input
            id="contact"
            name="contact"
            type="email"
            required
            autocomplete="email"
            inputmode="email"
            placeholder="you@example.com"
            class="w-full bg-[var(--cream)] text-[var(--dark-charcoal)] px-4 py-3 rounded-md min-h-[48px] border border-[var(--deep-slate)]/20 focus:border-[var(--brand-blue)] outline-none placeholder:text-[var(--dark-charcoal)]/50"
          />
        </div>

        <div>
          <label for="studio" class="block text-sm font-medium mb-2 text-[var(--dark-charcoal)]">Which studio? <span aria-hidden="true">*</span></label>
          <select
            id="studio"
            name="studio"
            required
            class="w-full bg-[var(--cream)] text-[var(--dark-charcoal)] px-4 py-3 rounded-md min-h-[48px] border border-[var(--deep-slate)]/20 focus:border-[var(--brand-blue)] outline-none"
          >
            <option value="Studio 28">Studio 28</option>
            <option value="Studio 49">Studio 49</option>
            <option value="Not sure yet">Not sure yet</option>
          </select>
        </div>

        <div>
          <label for="when" class="block text-sm font-medium mb-2 text-[var(--dark-charcoal)]">When do you need it? <span aria-hidden="true">*</span></label>
          <input
            id="when"
            name="when"
            type="date"
            required
            min={today}
            class="w-full bg-[var(--cream)] text-[var(--dark-charcoal)] px-4 py-3 rounded-md min-h-[48px] border border-[var(--deep-slate)]/20 focus:border-[var(--brand-blue)] outline-none"
          />
          <p class="mt-2 text-xs text-[var(--dark-charcoal)]/70">
            Need a recurring slot or not sure yet? Just pick a rough date — we&rsquo;ll work it out together.
          </p>
        </div>

        <label class="flex items-start gap-3 cursor-pointer select-none">
          <input
            id="newsletter"
            name="newsletter"
            type="checkbox"
            value="yes"
            class="mt-1 w-5 h-5 flex-shrink-0 accent-[var(--brand-blue)] cursor-pointer"
          />
          <span class="text-sm text-[var(--dark-charcoal)]/85 leading-snug">
            Keep me updated on studio news and offers. Unsubscribe anytime.
          </span>
        </label>

        <button
          id="submit-btn"
          type="submit"
          class="press w-full bg-[var(--yellow)] text-[var(--dark-charcoal)] font-medium text-lg px-6 py-4 rounded-full min-h-[52px] hover:brightness-95 transition disabled:opacity-60 disabled:cursor-not-allowed"
        >
          Send Inquiry →
        </button>

        <p id="form-error" hidden role="alert" class="text-white bg-red-700/80 rounded-md px-4 py-3 text-sm">
          Something went wrong. Please try again, or message us on WhatsApp.
        </p>

        <p class="text-center text-sm text-[var(--dark-charcoal)]/70">
          We&rsquo;ll get back to you within a few hours.
        </p>
      </div>
    </form>

    <div class="mt-12 pt-10 border-t border-[var(--deep-slate)]/15 text-center">
      <p class="eyebrow mb-4">Faster reply</p>
      <a
        href="https://wa.me/353838803666"
        target="_blank"
        rel="noopener"
        class="press inline-flex items-center justify-center gap-3 bg-[#25D366] text-white font-medium text-lg md:text-xl px-8 py-5 rounded-full min-h-[56px] hover:bg-[#1ebe5a] transition-colors w-full sm:w-auto"
      >
        <svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.1-.2.3-.8.9-1 1.1-.2.2-.4.2-.7.1-.3-.1-1.2-.4-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.3-.4.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.2.2-1.4-.1-.2-.3-.3-.6-.4zM12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.4 1.3 4.9L2 22l5.3-1.4c1.4.8 3 1.2 4.7 1.2 5.5 0 10-4.5 10-10S17.5 2 12 2z"/>
        </svg>
        Message us on WhatsApp
      </a>
      <p class="mt-3 text-sm text-[var(--dark-charcoal)]/70">Quickest way to reach us.</p>
    </div>

    <div id="form-success" hidden class="text-center py-12" role="status" aria-live="polite">
      <svg class="w-16 h-16 mx-auto mb-4 text-[var(--brand-blue)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 12l3 3 5-6"/>
      </svg>
      <p class="text-2xl font-medium text-[var(--brand-blue)]">Thanks — we&rsquo;ll be in touch shortly.</p>
    </div>
  </div>
</section>
