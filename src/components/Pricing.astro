---
const rows = [
  ["Off-peak", "£13/hr", "£24/hr"],
  ["Standard", "£15/hr", "£26/hr"],
  ["Peak", "£18/hr", "£31/hr"],
  ["Weekends", "£18/hr", "£31/hr"],
];
---
<section class="bg-[var(--cream)] py-16 md:py-24 border-t border-[var(--deep-slate)]/15">
  <div class="max-w-[1000px] mx-auto px-4 md:px-6 lg:px-12">
    <div class="reveal text-center mb-10">
      <p class="eyebrow mb-3">Pricing</p>
      <h2 class="text-3xl md:text-5xl font-medium text-[var(--brand-blue)] mb-3">Honest, simple pricing</h2>
      <p class="text-lg text-[var(--dark-charcoal)]/80">No membership. No hidden fees. What you see is what you get.</p>
    </div>
    <div class="overflow-x-auto rounded-xl border border-[var(--deep-slate)]/15 bg-[var(--paper)]">
      <table class="w-full text-left">
        <thead class="bg-[var(--deep-slate)] text-[var(--cream)]">
          <tr>
            <th scope="col" class="px-4 md:px-6 py-4 text-base font-medium">Time</th>
            <th scope="col" class="px-4 md:px-6 py-4 text-base font-medium">Studio 28</th>
            <th scope="col" class="px-4 md:px-6 py-4 text-base font-medium">Studio 49</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(([label, s28, s49]) => (
            <tr class="border-t border-[var(--deep-slate)]/10">
              <th scope="row" class="px-4 md:px-6 py-4 font-medium text-[var(--brand-blue)]">{label}</th>
              <td class="px-4 md:px-6 py-4 tabular-nums text-[var(--dark-charcoal)]">{s28}</td>
              <td class="px-4 md:px-6 py-4 tabular-nums text-[var(--dark-charcoal)]">{s49}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-6 text-sm text-center text-[var(--dark-charcoal)]/75">
      Off-peak: 6am–noon · Standard: noon–6pm · Peak: 6pm–11pm · Weekends at peak rate
    </p>
    <p class="mt-1 text-sm text-center text-[var(--dark-charcoal)]/75">
      Two-hour minimum — book directly on the calendar.
    </p>
  </div>
</section>
