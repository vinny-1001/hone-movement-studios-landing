---
// Brand chrome — cream header + slate nav island + thin slate rule.
// Mirrors calendar.honemovementstudios.com.
---

<header class="brand-header">
  <div class="brand-header-inner">
    <a href="/" class="brand-logo-link" aria-label="Hone Movement Studios — home">
      <img
        src="/logos/hone-blue.png"
        alt="Hone Movement Studios"
        width="600"
        height="300"
        class="brand-logo"
      />
    </a>
    <nav class="brand-nav" aria-label="Primary">
      <div class="nav-island">
        <a href="#inquiry" class="nav-ghost">Enquire</a>
        <a
          href="https://calendar.honemovementstudios.com/book"
          class="nav-accent"
        >
          Book a studio
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .brand-header {
    background: var(--cream);
    border-bottom: 1px solid rgba(60, 58, 75, 0.35);
  }
  .brand-header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .brand-header-inner {
      padding: 1rem 1.5rem;
    }
  }
  .brand-logo-link {
    display: block;
  }
  .brand-logo {
    height: 64px;
    width: auto;
  }
  @media (min-width: 640px) {
    .brand-logo {
      height: 80px;
    }
  }
  .brand-nav {
    display: flex;
    align-items: center;
  }
  .nav-island {
    background: var(--deep-slate);
    border-radius: 9999px;
    padding: 0.25rem;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .nav-ghost {
    padding: 0.375rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    color: rgba(249, 245, 239, 0.85);
    transition: background-color 220ms, color 220ms;
  }
  .nav-ghost:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--cream);
  }
  .nav-accent {
    background: var(--yellow);
    color: var(--dark-charcoal);
    padding: 0.375rem 1rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    transition: filter 220ms;
  }
  .nav-accent:hover {
    filter: brightness(0.95);
  }
</style>
